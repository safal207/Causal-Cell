{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causal-cell.example/schema/action-draft.v0.1.schema.json",
  "title": "Causal Cell Action Draft v0.1",
  "description": "Untrusted model output. Contains no authority, identity, policy, approval, tool, nonce, delegation, or budget fields.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile",
        "kind",
        "capability_id",
        "target",
        "arguments"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "profile": {
          "const": "org.causalcell.action-draft.v0.1"
        },
        "kind": {
          "const": "ACTION"
        },
        "capability_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\s)(?:.|\\n)*\\S$"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\s)(?:.|\\n)*\\S$"
        },
        "arguments": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile",
        "kind",
        "reason_codes"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "profile": {
          "const": "org.causalcell.action-draft.v0.1"
        },
        "kind": {
          "const": "NO_ACTION"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\s)(?:.|\\n)*\\S$"
          }
        }
      }
    }
  ]
}
