{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:causal-cell:schema:policy:v0.1",
  "title": "Causal Cell trusted policy v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "policy_version",
    "allowed_subjects",
    "allowed_agents",
    "allowed_workloads",
    "allowed_actions",
    "allowed_action_scopes",
    "allowed_scopes",
    "network_scopes",
    "allowed_destinations",
    "allowed_secret_destinations",
    "trusted_tools",
    "allowed_delegation_chains",
    "approval_required_risk_tiers",
    "require_approval_for_irreversible",
    "max_resource_budget",
    "approvals"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "const": "org.causalcell.policy.v0.1"
    },
    "policy_version": {
      "$ref": "#/$defs/identifier"
    },
    "allowed_subjects": {
      "$ref": "#/$defs/identifier_array"
    },
    "allowed_agents": {
      "$ref": "#/$defs/identifier_array"
    },
    "allowed_workloads": {
      "$ref": "#/$defs/identifier_array"
    },
    "allowed_actions": {
      "$ref": "#/$defs/identifier_array"
    },
    "allowed_scopes": {
      "$ref": "#/$defs/identifier_array"
    },
    "network_scopes": {
      "$ref": "#/$defs/identifier_array"
    },
    "allowed_destinations": {
      "$ref": "#/$defs/identifier_array"
    },
    "allowed_secret_destinations": {
      "$ref": "#/$defs/identifier_array"
    },
    "trusted_tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "origin",
          "version",
          "schema_digest"
        ],
        "properties": {
          "origin": {
            "$ref": "#/$defs/identifier"
          },
          "version": {
            "$ref": "#/$defs/identifier"
          },
          "schema_digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "allowed_delegation_chains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier_array"
      }
    },
    "approval_required_risk_tiers": {
      "type": "array",
      "items": {
        "enum": [
          "low",
          "medium",
          "high",
          "critical"
        ]
      },
      "uniqueItems": true
    },
    "require_approval_for_irreversible": {
      "type": "boolean"
    },
    "max_resource_budget": {
      "$ref": "#/$defs/resource_budget"
    },
    "approvals": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "proposal_digest",
          "arguments_digest",
          "target",
          "target_state_digest",
          "policy_version",
          "subject",
          "auth_context_digest",
          "expires_at"
        ],
        "properties": {
          "status": {
            "enum": [
              "ACTIVE",
              "REVOKED"
            ]
          },
          "proposal_digest": {
            "$ref": "#/$defs/digest"
          },
          "arguments_digest": {
            "$ref": "#/$defs/digest"
          },
          "target": {
            "$ref": "#/$defs/identifier"
          },
          "target_state_digest": {
            "$ref": "#/$defs/digest"
          },
          "policy_version": {
            "$ref": "#/$defs/identifier"
          },
          "subject": {
            "$ref": "#/$defs/identifier"
          },
          "auth_context_digest": {
            "$ref": "#/$defs/digest"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "allowed_action_scopes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/identifier_array"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)[\\s\\S]*\\S$"
    },
    "identifier_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_steps",
        "max_seconds",
        "max_cost",
        "max_fan_out",
        "max_retries"
      ],
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost": {
          "type": "number",
          "minimum": 0
        },
        "max_fan_out": {
          "type": "integer",
          "minimum": 0
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
